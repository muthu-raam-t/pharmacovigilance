# Copy to .env and change as needed. Every value has a default matching docker-compose.yml,
# so the project runs without a .env file.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=drug_safety_db
POSTGRES_USER=drug_user
POSTGRES_PASSWORD=drug_password
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=drugsafety123
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
